# Copy this file to .env and fill in real values
# cp .env.example .env

# ── Database ─────────────────────────────────────────
DB_PASSWORD=secret123
DB_NAME=serverpilot
DB_USER=serverpilot

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ── App ──────────────────────────────────────────────
APP_ENV=development
BACKEND_PORT=8081

# ── Agent ────────────────────────────────────────────
AGENT_SECRET=change-this-agent-secret-too
